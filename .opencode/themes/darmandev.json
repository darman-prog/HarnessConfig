{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#1a1b26",
    "bg-alt": "#1f2335",
    "fg": "#e8e8e8",
    "fg-muted": "#7a7a8c",
    "accent": "#7aa2f7",
    "accent-secondary": "#bb9af7",
    "success": "#9ece6a",
    "error": "#f7768e",
    "warning": "#e0af68",
    "info": "#7dcfff",
    "highlight": "#e0af68",
    "border": "#414868",
    "border-subtle": "#3b4261",
    "diff-bg-add": "#42513a",
    "diff-bg-del": "#5c3645",
    "error-bright": "#ff8ba3",
    "diff-lineno": "#c0c6d6"
  },
  "theme": {
    "primary": { "dark": "accent", "light": "accent" },
    "secondary": { "dark": "accent-secondary", "light": "accent-secondary" },
    "accent": { "dark": "accent", "light": "accent" },
    "text": { "dark": "fg", "light": "fg" },
    "textMuted": { "dark": "fg-muted", "light": "fg-muted" },
    "background": { "dark": "bg", "light": "bg" },
    "backgroundPanel": { "dark": "bg-alt", "light": "bg-alt" },
    "backgroundElement": { "dark": "bg-alt", "light": "bg-alt" },
    "backgroundMenu": { "dark": "bg-alt", "light": "bg-alt" },
    "border": { "dark": "border", "light": "border" },
    "borderActive": { "dark": "accent", "light": "accent" },
    "borderSubtle": { "dark": "border-subtle", "light": "border-subtle" },
    "error": { "dark": "error", "light": "error" },
    "warning": { "dark": "warning", "light": "warning" },
    "success": { "dark": "success", "light": "success" },
    "info": { "dark": "info", "light": "info" },

    "diffAdded": { "dark": "success", "light": "success" },
    "diffRemoved": { "dark": "error-bright", "light": "error-bright" },
    "diffContext": { "dark": "fg-muted", "light": "fg-muted" },
    "diffHunkHeader": { "dark": "fg-muted", "light": "fg-muted" },
    "diffHighlightAdded": { "dark": "success", "light": "success" },
    "diffHighlightRemoved": { "dark": "error-bright", "light": "error-bright" },
    "diffAddedBg": { "dark": "diff-bg-add", "light": "diff-bg-add" },
    "diffRemovedBg": { "dark": "diff-bg-del", "light": "diff-bg-del" },
    "diffContextBg": { "dark": "bg", "light": "bg" },
    "diffLineNumber": { "dark": "diff-lineno", "light": "diff-lineno" },
    "diffAddedLineNumberBg": { "dark": "diff-bg-add", "light": "diff-bg-add" },
    "diffRemovedLineNumberBg": { "dark": "diff-bg-del", "light": "diff-bg-del" },

    "markdownText": { "dark": "fg", "light": "fg" },
    "markdownHeading": { "dark": "accent", "light": "accent" },
    "markdownLink": { "dark": "info", "light": "info" },
    "markdownLinkText": { "dark": "info", "light": "info" },
    "markdownCode": { "dark": "success", "light": "success" },
    "markdownBlockQuote": { "dark": "fg-muted", "light": "fg-muted" },
    "markdownEmph": { "dark": "warning", "light": "warning" },
    "markdownStrong": { "dark": "highlight", "light": "highlight" },
    "markdownHorizontalRule": { "dark": "border-subtle", "light": "border-subtle" },
    "markdownListItem": { "dark": "accent", "light": "accent" },
    "markdownListEnumeration": { "dark": "accent-secondary", "light": "accent-secondary" },
    "markdownImage": { "dark": "accent", "light": "accent" },
    "markdownImageText": { "dark": "accent-secondary", "light": "accent-secondary" },
    "markdownCodeBlock": { "dark": "fg", "light": "fg" },

    "syntaxComment": { "dark": "fg-muted", "light": "fg-muted" },
    "syntaxKeyword": { "dark": "accent-secondary", "light": "accent-secondary" },
    "syntaxFunction": { "dark": "accent", "light": "accent" },
    "syntaxVariable": { "dark": "fg", "light": "fg" },
    "syntaxString": { "dark": "success", "light": "success" },
    "syntaxNumber": { "dark": "highlight", "light": "highlight" },
    "syntaxType": { "dark": "accent-secondary", "light": "accent-secondary" },
    "syntaxOperator": { "dark": "info", "light": "info" },
    "syntaxPunctuation": { "dark": "fg", "light": "fg" },

    "thinkingOpacity": 0.5
  }
}
