{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "default_agent": "build",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 20480
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git diff*": "allow",
      "git status*": "allow",
      "git log*": "allow"
    },
    "skill": {
      "*": "allow"
    }
  }
}
